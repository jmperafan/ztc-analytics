[sqlfluff]
templater = jinja
dialect = snowflake
max_line_length = 120
exclude_rules = RF05,ST06

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
capitalisation_policy = upper

[sqlfluff:templater:jinja]
apply_dbt_builtins = true

[sqlfluff:templater:jinja:macros]
set_job_param_macro = """{% macro set_job_param() %}{% endmacro %}"""
update_job_param_macro = """{% macro update_job_param(success) %}{% endmacro %}"""
get_previous_hwm_macro = """{% macro get_previous_hwm(model) %}'1900-01-01'{% endmacro %}"""
get_current_hwm_macro = """{% macro get_current_hwm(model) %}'2099-12-31'{% endmacro %}"""
